{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://suriya-25-agentshelf-api.hf.space/api/:path*" },
    { "source": "/mcp", "destination": "https://suriya-25-agentshelf-api.hf.space/mcp" },
    { "source": "/mcp/:path*", "destination": "https://suriya-25-agentshelf-api.hf.space/mcp/:path*" },
    { "source": "/.well-known/:path*", "destination": "https://suriya-25-agentshelf-api.hf.space/.well-known/:path*" },
    { "source": "/checkout/:path*", "destination": "https://suriya-25-agentshelf-api.hf.space/checkout/:path*" },
    { "source": "/webhooks/:path*", "destination": "https://suriya-25-agentshelf-api.hf.space/webhooks/:path*" },
    { "source": "/healthz", "destination": "https://suriya-25-agentshelf-api.hf.space/healthz" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
