{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://agentshelf-api.onrender.com/api/:path*" },
    { "source": "/mcp", "destination": "https://agentshelf-api.onrender.com/mcp" },
    { "source": "/mcp/:path*", "destination": "https://agentshelf-api.onrender.com/mcp/:path*" },
    { "source": "/.well-known/:path*", "destination": "https://agentshelf-api.onrender.com/.well-known/:path*" },
    { "source": "/checkout/:path*", "destination": "https://agentshelf-api.onrender.com/checkout/:path*" },
    { "source": "/webhooks/:path*", "destination": "https://agentshelf-api.onrender.com/webhooks/:path*" },
    { "source": "/healthz", "destination": "https://agentshelf-api.onrender.com/healthz" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
