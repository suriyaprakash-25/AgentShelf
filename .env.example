APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentshelf
PUBLIC_API_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

# Optional streaming replica for anonymous catalog reads (falls back to the primary).
# DATABASE_READ_URL=postgresql+psycopg://reader:...@replica:5432/agentshelf
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_NETWORK_TIMEOUT_MS=10000
# REQUEST_DEADLINE_SECONDS=15
# PROVIDER_REQUEST_DEADLINE_SECONDS=75
# Seconds to reuse anonymous catalog reads in-process (0 disables).
# PUBLIC_CACHE_SECONDS=10
# Proxies that append X-Forwarded-For (unset: 1 in staging/production, 0 locally).
# TRUSTED_PROXY_HOPS=1
# Shared HMAC key for signed Playground MCP calls across replicas (derived if unset).
# SERVICE_SIGNING_KEY=
# Container only: uvicorn workers and proxy addresses allowed to rewrite client info.
# WEB_CONCURRENCY=2
# FORWARDED_ALLOW_IPS=127.0.0.1

PAYPAL_MODE=sandbox
LIVE_CHECKOUT_ENABLED=false
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
# PAYPAL_WEBHOOK_ID=
# LIVE_MERCHANT_ID=

# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3 reasoning depth: minimal | low | medium | high (default low).
# GEMINI_THINKING_LEVEL=low
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

MEDIA_BACKEND=local
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_PAID_TEMPLATE=agentshelf_order_paid
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# SENTRY_DSN=
# BROWSER_SENTRY_DSN=
# RESEND_API_KEY=
# EMAIL_FROM=orders@agentshelf.local
