APP_ENV=local
DATABASE_URL=postgresql+psycopg://agentshelf:local-development-only@127.0.0.1:5433/agentshelf
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
PAYPAL_MODE=sandbox
LIVE_CHECKOUT_ENABLED=false
# Set these through your secret manager. Never commit their values.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# LIVE_MERCHANT_ID=
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Local files are for development only. Deployed API and worker share a private bucket.
MEDIA_BACKEND=local
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_PAID_TEMPLATE=  # Approved utility template with four body parameters; see runbook.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# SENTRY_DSN=
# RESEND_API_KEY=
# EMAIL_FROM=

# Browser-visible commercial licence, not a provider API secret.
# Build frontend with VITE_AG_STUDIO_LICENSE_KEY after sponsor licence approval.
